{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:revision:schemas:DataQualityAssessment:1",
  "title": "Revision certificate-derived NGSI-LD assessment application profile",
  "description": "Structural application profile; not ETSI conformance or report authentication.",
  "type": "object",
  "required": [
    "id",
    "type",
    "@context",
    "refEntity",
    "refProperty",
    "phase",
    "standard",
    "dimension",
    "metricCode",
    "metricValue",
    "unit",
    "result",
    "contextWindow",
    "evaluator",
    "evidenceSource",
    "evidenceHash",
    "evidenceHashScope",
    "evidenceIntegrityStatus",
    "sourceRecord"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:ngsi-ld:DataQualityAssessment:"
    },
    "type": {
      "const": "DataQualityAssessment"
    },
    "@context": {
      "type": "object"
    },
    "refEntity": {
      "type": "object",
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "object": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
        }
      }
    },
    "refProperty": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "standard": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dimension": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metricCode": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metricValue": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "unit": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        }
      }
    },
    "contextWindow": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluator": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceSource": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceHash": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "evidenceHashScope": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceIntegrityStatus": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "const": "source-unverified"
        }
      }
    },
    "sourceRecord": {
      "type": "object",
      "required": [
        "type",
        "object"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Relationship"
        },
        "object": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
        }
      }
    },
    "thresholdMin": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "thresholdMax": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "qualityClass": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pollutant": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "device": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Property"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "thresholdMin"
      ]
    },
    {
      "required": [
        "thresholdMax"
      ]
    }
  ]
}
